{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplecad.dev/schemas/assembly-definition-2.schema.json",
  "title": "SimpleCAD AssemblyDefinition 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "definition_kind", "definition_id", "revision", "content_hash", "units", "tolerance_profile", "profile", "generator", "definition_refs", "instances", "relations", "grounded_instance_ids", "public_connectors", "interface_hashes", "solved_snapshot", "feature_graph_ref", "metadata"],
  "properties": {
    "schema_version": {"const": "2.0"},
    "artifact_kind": {"const": "assembly_definition"},
    "definition_kind": {"const": "assembly"},
    "definition_id": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/revision"},
    "content_hash": {"$ref": "#/$defs/hash"},
    "units": {"const": "mm"},
    "tolerance_profile": {"type": "string", "minLength": 1, "maxLength": 128},
    "profile": {"const": "simplecad-assembly-definition-2"},
    "generator": {"$ref": "#/$defs/generator"},
    "definition_refs": {"type": "array", "maxItems": 25000, "items": {"$ref": "#/$defs/partRef"}},
    "instances": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/instance"}},
    "relations": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/relation"}},
    "grounded_instance_ids": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/id"}},
    "public_connectors": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/connector"}},
    "interface_hashes": {"$ref": "#/$defs/interfaceHashes"},
    "solved_snapshot": {"type": ["object", "null"]},
    "feature_graph_ref": {"$ref": "#/$defs/blobRef"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "revision": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "path": {"type": "string", "minLength": 1, "maxLength": 4096, "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "vec3": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
    "frame": {"type": "object", "additionalProperties": false, "required": ["origin", "x_axis", "y_axis", "z_axis"], "properties": {"origin": {"$ref": "#/$defs/vec3"}, "x_axis": {"$ref": "#/$defs/vec3"}, "y_axis": {"$ref": "#/$defs/vec3"}, "z_axis": {"$ref": "#/$defs/vec3"}}},
    "generator": {"type": "object", "additionalProperties": false, "required": ["simplecadapi_version", "ocp_version", "python_abi", "platform_tag", "semantic_registry_version"], "properties": {"simplecadapi_version": {"$ref": "#/$defs/revision"}, "ocp_version": {"$ref": "#/$defs/revision"}, "python_abi": {"$ref": "#/$defs/revision"}, "platform_tag": {"$ref": "#/$defs/revision"}, "semantic_registry_version": {"$ref": "#/$defs/revision"}}},
    "blobRef": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "byte_length", "media_type"], "properties": {"path": {"$ref": "#/$defs/path"}, "sha256": {"$ref": "#/$defs/hash"}, "byte_length": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "media_type": {"type": "string", "minLength": 1, "maxLength": 128}}},
    "partRef": {"type": "object", "additionalProperties": false, "required": ["definition_id", "definition_kind", "path", "revision", "content_hash", "byte_length"], "properties": {"definition_id": {"$ref": "#/$defs/id"}, "definition_kind": {"enum": ["single_solid", "assembly"]}, "path": {"$ref": "#/$defs/path"}, "revision": {"$ref": "#/$defs/revision"}, "content_hash": {"$ref": "#/$defs/hash"}, "byte_length": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}}},
    "instance": {"type": "object", "additionalProperties": false, "required": ["instance_id", "definition_id", "name", "placement"], "properties": {"instance_id": {"$ref": "#/$defs/id"}, "definition_id": {"$ref": "#/$defs/id"}, "name": {"type": ["string", "null"], "minLength": 1}, "placement": {"$ref": "#/$defs/frame"}}},
    "connectorRef": {"type": "object", "additionalProperties": false, "required": ["component_id", "connector_id"], "properties": {"component_id": {"$ref": "#/$defs/id"}, "connector_id": {"$ref": "#/$defs/id"}}},
    "relation": {"type": "object", "additionalProperties": false, "required": ["constraint_id", "constraint_kind", "connector_a", "connector_b", "drive_distance", "distance_limit", "drive_angle_degrees", "angle_limit", "pitch_radius_a", "pitch_radius_b", "pulley_radius_a", "pulley_radius_b", "pitch_radius", "phase_offset", "name"], "properties": {"constraint_id": {"$ref": "#/$defs/id"}, "constraint_kind": {"enum": ["fixed", "revolute", "prismatic", "gear", "belt", "rack_pinion"]}, "connector_a": {"$ref": "#/$defs/connectorRef"}, "connector_b": {"$ref": "#/$defs/connectorRef"}, "drive_distance": {"type": ["number", "null"]}, "distance_limit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/scalarLimit"}]}, "drive_angle_degrees": {"type": ["number", "null"]}, "angle_limit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/scalarLimit"}]}, "pitch_radius_a": {"type": ["number", "null"]}, "pitch_radius_b": {"type": ["number", "null"]}, "pulley_radius_a": {"type": ["number", "null"]}, "pulley_radius_b": {"type": ["number", "null"]}, "pitch_radius": {"type": ["number", "null"]}, "phase_offset": {"type": ["number", "null"]}, "name": {"type": ["string", "null"], "minLength": 1}}},
    "scalarLimit": {"type": "object", "additionalProperties": false, "required": ["lower_value", "upper_value"], "properties": {"lower_value": {"type": "number"}, "upper_value": {"type": "number"}}},
    "connector": {"type": "object", "additionalProperties": false, "required": ["connector_id", "name", "anchor_kind", "local_frame", "binding", "forwarded_from", "interface_hash", "binding_hash"], "properties": {"connector_id": {"$ref": "#/$defs/id"}, "name": {"type": ["string", "null"], "minLength": 1}, "anchor_kind": {"const": "forwarded"}, "local_frame": {"$ref": "#/$defs/frame"}, "binding": {"type": "null"}, "forwarded_from": {"type": "object", "additionalProperties": false, "required": ["component_id", "connector_id"], "properties": {"component_id": {"$ref": "#/$defs/id"}, "connector_id": {"$ref": "#/$defs/id"}}}, "interface_hash": {"$ref": "#/$defs/hash"}, "binding_hash": {"$ref": "#/$defs/hash"}}},
    "hashMap": {"type": "object", "propertyNames": {"$ref": "#/$defs/id"}, "additionalProperties": {"$ref": "#/$defs/hash"}},
    "interfaceHashes": {"type": "object", "additionalProperties": false, "required": ["geometry", "connectors", "bindings", "material"], "properties": {"geometry": {"$ref": "#/$defs/hash"}, "connectors": {"$ref": "#/$defs/hashMap"}, "bindings": {"$ref": "#/$defs/hashMap"}, "material": {"type": "null"}}}
  }
}
