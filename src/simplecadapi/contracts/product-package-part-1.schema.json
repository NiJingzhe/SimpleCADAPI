{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplecad.dev/schemas/product-package-part-1.schema.json",
  "title": "SimpleCAD Part Product Package 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "definition_kind",
    "part_id",
    "definition_id",
    "revision",
    "content_hash",
    "units",
    "tolerance_profile",
    "name",
    "body_ref",
    "topology_ref",
    "connector_ref",
    "material_ref",
    "model_ref",
    "definition_uri",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_kind": {"const": "part"},
    "definition_kind": {"const": "single_solid"},
    "part_id": {"$ref": "#/$defs/id"},
    "definition_id": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/hash"},
    "content_hash": {"$ref": "#/$defs/hash"},
    "units": {"const": "mm"},
    "tolerance_profile": {"type": "string", "minLength": 1, "maxLength": 128},
    "name": {"type": ["string", "null"], "minLength": 1},
    "body_ref": {"$ref": "#/$defs/blobRef"},
    "topology_ref": {"$ref": "#/$defs/blobRef"},
    "connector_ref": {"$ref": "#/$defs/blobRef"},
    "material_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/blobRef"}]},
    "model_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/blobRef"}]},
    "definition_uri": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "blobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "media_type", "byte_length", "content_hash"],
      "properties": {
        "uri": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "byte_length": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    }
  }
}
