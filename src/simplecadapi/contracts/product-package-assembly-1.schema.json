{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simplecad.dev/schemas/product-package-assembly-1.schema.json",
  "title": "SimpleCAD Assembly Product Package 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_kind", "definition_kind", "assembly_id", "definition_id", "revision", "content_hash", "units", "tolerance_profile", "name", "definitions", "instances", "relations", "grounded_instance_ids", "connectors", "solved_snapshot", "model_ref", "definition_uri", "metadata"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_kind": {"const": "assembly"},
    "definition_kind": {"const": "assembly"},
    "assembly_id": {"$ref": "#/$defs/id"},
    "definition_id": {"$ref": "#/$defs/id"},
    "revision": {"$ref": "#/$defs/hash"},
    "content_hash": {"$ref": "#/$defs/hash"},
    "units": {"const": "mm"},
    "tolerance_profile": {"type": "string", "minLength": 1, "maxLength": 128},
    "name": {"type": ["string", "null"], "minLength": 1},
    "definitions": {"type": "array", "maxItems": 25000, "items": {"$ref": "#/$defs/definitionRef"}},
    "instances": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/instance"}},
    "relations": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/constraint"}},
    "grounded_instance_ids": {"type": "array", "maxItems": 100000, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "connectors": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/connector"}},
    "solved_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_placements"],
      "properties": {
        "component_placements": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component_id", "placement"],
            "properties": {
              "component_id": {"$ref": "#/$defs/id"},
              "placement": {"$ref": "#/$defs/placement"}
            }
          }
        }
      }
    },
    "model_ref": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/blobRef"}]},
    "definition_uri": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
    "metadata": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "vec3": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}],
      "minItems": 3,
      "maxItems": 3
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["origin", "x_axis", "y_axis", "z_axis"],
      "properties": {
        "origin": {"$ref": "#/$defs/vec3"},
        "x_axis": {"$ref": "#/$defs/vec3"},
        "y_axis": {"$ref": "#/$defs/vec3"},
        "z_axis": {"$ref": "#/$defs/vec3"}
      }
    },
    "blobRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "media_type", "byte_length", "content_hash"],
      "properties": {
        "uri": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 128},
        "byte_length": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "content_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "definitionRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_id", "definition_kind", "uri", "content_hash", "byte_length", "blob_hash"],
      "properties": {
        "definition_id": {"$ref": "#/$defs/id"},
        "definition_kind": {"enum": ["part", "assembly"]},
        "uri": {"type": "string", "pattern": "^definitions/[A-Za-z0-9._~-]+\\.(part|assembly)\\.json$"},
        "content_hash": {"$ref": "#/$defs/hash"},
        "byte_length": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "blob_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "definition_ref", "name", "local_placement"],
      "properties": {
        "instance_id": {"$ref": "#/$defs/id"},
        "definition_ref": {"type": "string", "pattern": "^definitions/[A-Za-z0-9._~-]+\\.(part|assembly)\\.json$"},
        "name": {"type": ["string", "null"], "minLength": 1},
        "local_placement": {"$ref": "#/$defs/placement"}
      }
    },
    "geometryRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source_node_id", "geo_selector", "flip"],
      "properties": {
        "kind": {"enum": ["face", "edge", "vertex"]},
        "source_node_id": {"type": ["string", "null"]},
        "geo_selector": {"type": "object"},
        "flip": {"type": "boolean"}
      }
    },
    "geometryAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_kind", "geometry_ref"],
      "properties": {
        "anchor_kind": {"const": "geometry"},
        "geometry_ref": {"$ref": "#/$defs/geometryRef"}
      }
    },
    "placementAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_kind", "placement"],
      "properties": {
        "anchor_kind": {"const": "placement"},
        "placement": {"$ref": "#/$defs/placement"}
      }
    },
    "forwardedAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchor_kind", "source_component_id", "source_connector_id", "offset"],
      "properties": {
        "anchor_kind": {"const": "forwarded"},
        "source_component_id": {"$ref": "#/$defs/id"},
        "source_connector_id": {"$ref": "#/$defs/id"},
        "offset": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/placement"}]}
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["connector_id", "name", "anchor"],
      "properties": {
        "connector_id": {"$ref": "#/$defs/id"},
        "name": {"type": ["string", "null"], "minLength": 1},
        "anchor": {"oneOf": [{"$ref": "#/$defs/geometryAnchor"}, {"$ref": "#/$defs/placementAnchor"}, {"$ref": "#/$defs/forwardedAnchor"}]},
        "geometry_ref": {"$ref": "#/$defs/geometryRef"}
      },
      "allOf": [
        {
          "if": {"properties": {"anchor": {"properties": {"anchor_kind": {"const": "geometry"}}, "required": ["anchor_kind"]}}, "required": ["anchor"]},
          "then": {"required": ["geometry_ref"]}
        },
        {
          "if": {"properties": {"anchor": {"properties": {"anchor_kind": {"enum": ["placement", "forwarded"]}}, "required": ["anchor_kind"]}}, "required": ["anchor"]},
          "then": {"not": {"required": ["geometry_ref"]}}
        }
      ]
    },
    "connectorRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "connector_id"],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "connector_id": {"$ref": "#/$defs/id"}
      }
    },
    "limit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower_value", "upper_value"],
      "properties": {
        "lower_value": {"type": "number"},
        "upper_value": {"type": "number"}
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraint_id", "constraint_kind", "connector_a", "connector_b", "drive_distance", "distance_limit", "drive_angle_degrees", "angle_limit", "pitch_radius_a", "pitch_radius_b", "pulley_radius_a", "pulley_radius_b", "pitch_radius", "phase_offset", "name"],
      "properties": {
        "constraint_id": {"$ref": "#/$defs/id"},
        "constraint_kind": {"enum": ["fixed", "revolute", "prismatic", "gear", "belt", "rack_pinion"]},
        "connector_a": {"$ref": "#/$defs/connectorRef"},
        "connector_b": {"$ref": "#/$defs/connectorRef"},
        "drive_distance": {"type": ["number", "null"]},
        "distance_limit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/limit"}]},
        "drive_angle_degrees": {"type": ["number", "null"]},
        "angle_limit": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/limit"}]},
        "pitch_radius_a": {"type": ["number", "null"]},
        "pitch_radius_b": {"type": ["number", "null"]},
        "pulley_radius_a": {"type": ["number", "null"]},
        "pulley_radius_b": {"type": ["number", "null"]},
        "pitch_radius": {"type": ["number", "null"]},
        "phase_offset": {"type": ["number", "null"]},
        "name": {"type": ["string", "null"], "minLength": 1}
      }
    }
  }
}
