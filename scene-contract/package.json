{
  "name": "simplecad-scene-contract-parity",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "generate:types": "uv run python ../tools/generate_scene_contract_types.py --language typescript",
    "check:types": "uv run python ../tools/generate_scene_contract_types.py --check --language typescript",
    "test": "npm run check:types && npm run build && node --test dist/test/*.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "json-schema-to-typescript": "15.0.4",
    "typescript": "5.7.2"
  }
}
